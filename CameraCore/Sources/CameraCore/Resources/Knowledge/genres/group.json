        "threshold": 0.45
      },
      {
        "kind": "eyesOpen",
        "threshold": 0.6
      },
      {
        "kind": "faceToward",
        "threshold": 30
      },
      {
        "kind": "deviceStill",
        "threshold": 0.12
      },
      {
        "kind": "highlightsSafe",
        "threshold": 0.01
      },
      {
        "kind": "exposureSettled"
      }
    ],
