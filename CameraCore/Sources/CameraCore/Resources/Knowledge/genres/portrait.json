{
  "id": "portrait",
  "name": "人像",
  "cues": {
    "labels": [
      "person",
      "portrait",
      "face",
      "selfie"
    ],
    "subjects": [
      "face"
    ],
    "measurements": [
      "画面中有一张主导人脸，人脸高度占画面 8% 以上"
    ]
  },
  "principles": {
    "composition": [
      "眼睛落在裁切框上三分线附近（y≈0.33–0.4），不要放在正中央",
      "视线或脸朝向的一侧多留空间：脸朝右时主体放左三分，反之亦然",
      "半身像头顶留白约为脸高的 0.3–0.6 倍；特写可以裁掉头顶，但不要裁掉下巴",
      "不要在关节处（脖子、手肘、手腕、膝盖、脚踝）切断肢体",
      "背景中的竖线、电线杆、树干不要从头顶「长出来」"
    ],
    "light": [
      "侧光或 45° 前侧光最讨好面部；正午顶光会在眼窝、鼻下留下硬阴影，宁可让人物转向或换到阴影里",
      "逆光时以脸部测光，接受背景变亮；发丝边缘的轮廓光是加分项",
      "窗边、阴天、树荫下的大面积柔光最适合人像",
      "眼睛里有一个清晰的眼神光（catchlight）时，脸会更有神"
    ],
    "exposure": [
      "以脸部为测光基准，肤色比中灰亮约 0.3–0.7 EV",
      "优先用大光圈分离背景，但人脸占比很大时保证两只眼睛都在景深内",
      "快门不低于 1/125 s，避免人物轻微动作造成的模糊",
      "高光（白衣、天空）溢出不超过 1%，脸部绝不能溢出"
    ],
    "timing": [
      "双眼睁开、视线明确（看镜头或看向画面内）",
      "表情自然放松，嘴角或眼神有情绪时再拍",
      "人物刚完成一个动作、处于短暂停顿时最稳"
    ],
    "faults": [
      "对焦在耳朵或背景而不是眼睛",
      "脸部偏暗而背景过亮",
      "广角近距离导致脸部变形（主体占比过大）",
      "背景杂物抢走注意力",
      "画面倾斜但并非有意为之"
    ]
  },
  "rubricWeights": {
    "clarity": 0.15,
    "exposure": 0.15,
    "composition": 0.15,
    "light": 0.2,
    "background": 0.1,
    "moment": 0.15,
    "genre": 0.1
  },
  "genreCriterion": {
    "name": "神情与连接",
    "low": "表情僵硬、闭眼或视线游离",
    "mid": "表情自然但普通",
    "high": "眼神有力、情绪真实，能与观者产生连接"
  },
  "defaultPlan": {
    "genre": "portrait",
    "genreConfidence": 1.0,
    "subject": "face",
    "composition": {
